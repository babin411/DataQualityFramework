# Copy to .env (git-ignored) and fill in. Read by `dqf`, `make` and scripts/local.py.
# In AWS the Lambda gets the same names as environment variables, and the login from Secrets Manager.

# ---- Snowflake login ---------------------------------------------------------------------------
# The account identifier: in Snowsight, your name (bottom left) > Account > "Copy account identifier"
# (orgname-accountname). The account locator form also works: e.g. ab12345.us-east-1
SNOWFLAKE_ACCOUNT=
# The service user from sql/01_setup.sql, logging in with the key from scripts/make_snowflake_key.sh
SNOWFLAKE_USER=DQF_SVC
SNOWFLAKE_ROLE=DQF_ROLE
SNOWFLAKE_WAREHOUSE=DQF_WH
SNOWFLAKE_DATABASE=DQF_DB
SNOWFLAKE_SCHEMA=DQF
# keypair (what the Lambda uses) | password | externalbrowser (your own sign-on; laptop only)
SNOWFLAKE_AUTH=keypair
# Absolute path, outside Git (scripts/make_snowflake_key.sh writes keys/, which is git-ignored)
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only for an encrypted key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only for SNOWFLAKE_AUTH=password
SNOWFLAKE_PASSWORD=

# ---- the framework -----------------------------------------------------------------------------
# The checks: config/dq_config.yaml (main), or config/dq_config.xlsx, or the folder config/sheets
DQF_CONFIG_URI=config/dq_config.yaml
DQF_RESULT_TABLE=DQF_DB.DQF.DQ_RESULT
DQF_REMIND_HOURS=24
# Great Expectations' own HTML report (Data Docs): a folder here, s3://bucket/prefix in AWS. Empty = off.
# Open build/data_docs/site/index.html in a browser after a run.
DQF_DATA_DOCS=build/data_docs
# The Streamlit report's address; every alert links to it. Empty = no link.
# Laptop: http://localhost:8501. Streamlit in Snowflake: the app's Snowsight address.
DQF_REPORT_URL=http://localhost:8501

# ---- alerts ------------------------------------------------------------------------------------
# Channels when running `dqf` on your machine: log, email, sns (comma separated)
DQF_ALERT_CHANNELS=log,email
# Channels for the Lambda in LocalStack (sns goes to LocalStack's SNS; email goes to DQF_SMTP_HOST)
DQF_LOCAL_ALERT_CHANNELS=sns,email,log
DQF_SNS_TOPIC_ARN=

# SMTP server for the email channel. The defaults send to the local mail catcher started by
# `make local-up` (inbox at http://localhost:8025); nothing leaves your machine.
# For real email instead: Gmail = smtp.gmail.com, port 587, your address as user, and an app password.
DQF_SMTP_HOST=localhost
DQF_SMTP_PORT=1025
DQF_SMTP_USER=
DQF_SMTP_PASSWORD=
DQF_EMAIL_FROM=dqf@localhost
# Comma separated
DQF_EMAIL_TO=data-quality@example.com

# ---- tests -------------------------------------------------------------------------------------
# `make test-snowflake` writes only here (created if missing), never to DQF_RESULT_TABLE
DQF_TEST_RESULT_TABLE=DQF_DB.DQF.DQ_RESULT_TEST
